# generate with: openssl rand -hex 32
# required to read and write encrypted config files
DDNS_SECRET=

# default: /config/ddns.json inside the container, ~/.config/ddns.json otherwise
DDNS_CONFIG_PATH=

# overrides ip_service_url from the config file
# examples: https://api64.ipify.org (IPv6 preferred), https://api.ipify.org (IPv4),
#           https://icanhazip.com
DDNS_IP_SERVICE_URL=

# Docker only: run as this uid/gid, defaults to the image user
PUID=
PGID=
