# generate with: openssl rand -hex 32
# required to read and write encrypted config files
DDNS_SECRET=

# default: /config/ddns.json inside the container, ~/.config/ddns.json otherwise
DDNS_CONFIG_PATH=

# overrides ip_service_url from the config file
# examples: https://api64.ipify.org (IPv6 preferred), https://api.ipify.org (IPv4),
#           https://icanhazip.com
DDNS_IP_SERVICE_URL=

# Docker only: the container runs as these ids so the mounted ./config stays
# writable. Set them to your host ids, which you can get with `id -u` / `id -g`.
PUID=1000
PGID=1000
